# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workflow_platform

# ── Redis (BullMQ) ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ───────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
JWT_SECRET=change_this_in_production_supersecret
WEBHOOK_BASE_URL=http://localhost:4000

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000
# Optional: separate WebSocket URL (defaults to VITE_API_BASE_URL)
VITE_WS_URL=http://localhost:4000

# ── HDV Big Five — APEX ───────────────────────────────────────────────────────
# Required for APEX and AI nodes; also used by DREAM's /simulate/generate
ANTHROPIC_API_KEY=sk-ant-...
# Optional: external APEX MoE routing service (falls back to built-in heuristic)
APEX_BASE_URL=
APEX_API_KEY=

# ── HDV Big Five — VISION ────────────────────────────────────────────────────
# Internal shared key for VISION trigger mode (must match both api and worker)
WORKFLOW_API_KEY=hdv-internal-key
# Worker needs this to call back to the API for sub-workflow triggers
WORKFLOW_API_URL=http://localhost:4000

# ── HDV Big Five — HOPE / Supabase ───────────────────────────────────────────
# Set these to enable Supabase JWT auth in the HOPE node and the API middleware
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4

# ── Docker / CORS ─────────────────────────────────────────────────────────────
# Origin the API allows for WebSocket and CORS (defaults to localhost:5173 dev)
FRONTEND_URL=http://localhost:3000
# Override API URL seen by the browser when running docker-compose
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000
