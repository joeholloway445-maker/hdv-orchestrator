# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workflow_platform

# ── Redis (BullMQ) ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ───────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
JWT_SECRET=change_this_in_production_supersecret
WEBHOOK_BASE_URL=http://localhost:4000

# 32-byte hex string used to encrypt stored credentials
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change_this_to_a_random_32_byte_hex_string_here

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL the API serves CORS and WebSocket connections from
FRONTEND_URL=http://localhost:3000
# Browser-side API and WebSocket URLs (used by Vite build)
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000

# ── AI inference (OpenAI-compatible — Ollama, vLLM, LM Studio, etc.) ─────────
# Point at any OpenAI-compatible endpoint — NO paid API key required.
# Ollama default: http://localhost:11434  (run: ollama serve)
# vLLM / LM Studio: http://localhost:8000
AI_BASE_URL=http://localhost:11434
# API key is optional for local runtimes; set to any string if required
AI_API_KEY=ollama
# Default model served by your local runtime (e.g. llama3.2, mistral, qwen2.5-coder)
AI_MODEL=llama3.2
# Optional: use a smaller/faster model for low-budget tasks
AI_MODEL_FAST=llama3.2
# Optional: use a larger model for high-budget / security tasks
AI_MODEL_POWER=llama3.2
# Optional: multimodal model for vision tasks (e.g. llava)
AI_MODEL_VISION=llava

# ── APEX MoE router (optional external routing service) ───────────────────────
# Falls back to built-in heuristic router when not set
APEX_BASE_URL=
APEX_API_KEY=

# ── VISION workflow engine ────────────────────────────────────────────────────
# Shared internal key for API <-> worker communication
WORKFLOW_API_KEY=hdv-internal-key
# Worker calls back to the API at this URL for sub-workflow triggers
WORKFLOW_API_URL=http://localhost:4000

# ── HOPE / Supabase ───────────────────────────────────────────────────────────
# Required to enable Supabase JWT auth in the API middleware and HOPE node
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── HDV Hostinger LLM (Hostinger KVM4 — STARTER/PRO plan models) ─────────────
# Point at Ollama running on your Hostinger VPS: e.g. http://<vps-ip>:11434
HDV_HOSTINGER_LLM_BASE_URL=
HDV_HOSTINGER_LLM_API_KEY=

# ── HDV Cloud LLM (cloud provider — PRO/ENTERPRISE plan) ─────────────────────
HDV_LLM_BASE_URL=
HDV_LLM_API_KEY=

# ── GPU Marketplace ───────────────────────────────────────────────────────────
# External GPU burst providers (Vast.ai / RunPod) for image+video generation.
# Leave blank to disable; APEX node falls back to CPU inference.
GPU_BURST_PROVIDER=vastai            # vastai | runpod | custom
GPU_BURST_API_KEY=
# RunPod endpoint (if GPU_BURST_PROVIDER=runpod)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Vast.ai (if GPU_BURST_PROVIDER=vastai)
VASTAI_API_KEY=

# ── Memory persistence path ───────────────────────────────────────────────────
MEMORY_PERSIST_PATH=./data/memory

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4

# ── Docker Compose overrides ──────────────────────────────────────────────────
# Postgres credentials used by docker-compose (matched in DATABASE_URL above)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=workflow_platform
# Host ports exposed by docker-compose
API_PORT=4000
FRONTEND_PORT=3000
