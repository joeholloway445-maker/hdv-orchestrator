generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Subscription tiers: HOPE is always free; upper studios are pay-gated.
// BYOK lets power users bring their own OpenAI-compatible endpoint.
// ---------------------------------------------------------------------------
enum SubscriptionPlan {
  FREE        // HOPE studio only
  STARTER     // + DREAM (Hostinger / small models)
  PRO         // + VISION (cloud models, higher param budget)
  ENTERPRISE  // + KNOLL + APEX (full platform, no param cap)
  BYOK        // tenant-supplied endpoint; no HDV platform bill
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  plan            SubscriptionPlan @default(FREE)
  tenantId        String?          @unique
  byokBaseUrl     String?
  byokApiKey      String?
  byokModel       String?
  maxActiveParams Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workflows       Workflow[]
  memories        UserMemory[]
  credentials     Credential[]
  globalVariables GlobalVariable[]
  apiTokens       ApiToken[]
  gpuListings     GpuListing[]
  wallet          Wallet?
  membership      Membership?
  orders          Order[]
  devices         Device[]
}

model Workflow {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  active          Boolean           @default(false)
  description     String?
  tags            String[]          @default([])
  errorWorkflowId String?
  timeoutMs       Int?
  maxConcurrency  Int?
  nodes           Json              @default("[]")
  edges           Json              @default("[]")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  executions      Execution[]
  versions        WorkflowVersion[]
}

model Execution {
  id         String             @id @default(cuid())
  workflowId String
  workflow   Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status     ExecutionStatus    @default(PENDING)
  data       Json?
  startedAt  DateTime           @default(now())
  finishedAt DateTime?
  nodeLogs   ExecutionNodeLog[]
}

model ExecutionNodeLog {
  id          String        @id @default(cuid())
  executionId String
  execution   Execution     @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId      String
  nodeType    String
  status      NodeLogStatus
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime      @default(now())
  finishedAt  DateTime?
}

model UserMemory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  value      Json
  workflowId String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, key, workflowId])
}

model Credential {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowVersion {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  name       String
  nodes      Json     @default("[]")
  edges      Json     @default("[]")
  createdAt  DateTime @default(now())
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  prefix     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model GlobalVariable {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

// ---------------------------------------------------------------------------
// GPU marketplace — users list their hardware; platform routes burst GPU work.
// ---------------------------------------------------------------------------
enum GpuListingStatus {
  ACTIVE
  PAUSED
  OFFLINE
}

model GpuListing {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  gpuModel    String
  vramGb      Int
  ratePerHour Float
  status      GpuListingStatus @default(ACTIVE)
  endpointUrl String
  apiKeyHash  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum NodeLogStatus {
  RUNNING
  SUCCESS
  ERROR
}

// ---------------------------------------------------------------------------
// Sea-Scyte models: wallet, membership, catalog, shop, devices
// ---------------------------------------------------------------------------

model Wallet {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceUsd   Float         @default(0)
  transactions WalletTx[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model WalletTx {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        String   // "deposit" | "withdrawal" | "royalty" | "purchase"
  amountUsd   Float
  description String?
  createdAt   DateTime @default(now())
}

model Membership {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier      String    @default("free") // "free" | "basic" | "pro" | "vip"
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ContentItem {
  id           String      @id @default(uuid())
  type         String      // "film" | "tv" | "music" | "merch"
  title        String
  description  String?
  tags         String[]
  licenseTerms Json?
  priceUsd     Float       @default(0)
  stock        Int?        // null = unlimited (digital)
  metadata     Json?
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Order {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]
  totalUsd  Float
  status    String      @default("pending") // "pending" | "paid" | "shipped" | "cancelled"
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model OrderItem {
  id            String      @id @default(uuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id])
  quantity      Int         @default(1)
  priceUsd      Float
}

model Device {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  token     String   @unique
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NewsArticle {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  body        String
  tags        String[]
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HopeCompanion {
  id              String    @id @default(cuid())
  tenantId        String    @unique
  mood            String    @default("idle")
  executionStatus String    @default("idle")
  lastActive      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Workflow Templates — built-in templates tenants can browse and clone.
// ---------------------------------------------------------------------------
model WorkflowTemplate {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String   @default("general")
  tier        String   @default("FREE")
  nodes       Json
  edges       Json
  createdAt   DateTime @default(now())
}
